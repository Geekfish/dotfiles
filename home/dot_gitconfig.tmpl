[include]
  path = ~/.gitconfig_shared
[user]
  name = {{ .name | quote }}
  email = {{ .email | quote }}
  # Public PGP key ID
  signingkey = {{ .signingkey | quote }}
[includeIf "gitdir:~/workspace/work/"]
  path = ~/.gitconfig_work
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = true
