{{- /* Asked once per machine. Answers stay in ~/.config/chezmoi/chezmoi.toml, never in this repo. */ -}}
{{- $work := promptBoolOnce . "work" "Work machine" -}}
{{- $name := promptStringOnce . "name" "Full name for git commits" -}}
{{- $email := promptStringOnce . "email" "Personal git email" -}}
{{- /* Public PGP key ID used to sign commits, as shown by: gpg --list-secret-keys --keyid-format=long */ -}}
{{- $signingkey := promptStringOnce . "signingkey" "Personal PGP signing key ID (public)" -}}
{{- $workEmail := "" -}}
{{- $workSigningkey := "" -}}
{{- if $work -}}
{{-   $workEmail = promptStringOnce . "workEmail" "Work git email" -}}
{{-   $workSigningkey = promptStringOnce . "workSigningkey" "Work PGP signing key ID (public)" -}}
{{- end -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
  work = {{ $work }}
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  signingkey = {{ $signingkey | quote }}
  workEmail = {{ $workEmail | quote }}
  workSigningkey = {{ $workSigningkey | quote }}
