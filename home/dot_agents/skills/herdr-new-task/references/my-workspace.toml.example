# Herdr workspaces for the herdr-new-task skill.
# Copy to ~/my-workspace.toml and edit. One [[workspace]] block per Herdr workspace.
#
#   label        Herdr workspace label. Matched case-insensitively.
#   cwd          Directory new tabs open in. A leading ~ expands to $HOME.
#   description  What the workspace is for. Also used to infer the workspace from a task.
#   named_only   Optional. true = never inferred, used only when the user names it.
#   prompt_suffix Optional. Sentence appended to every agent prompt started in this workspace.
#   tracker      Optional. "linear", "github" (repo of cwd) or "github:<owner>/<repo>".
#                A top-level tracker key sets the default for all workspaces.

# tracker = "github"

[[workspace]]
label = "Orchestrator"
cwd = "~/workspace/"
description = "Coordinating work across other workspaces"
named_only = true
